    <add name="FlexiBillsAccounting.Settings.ConnectionStringGymIntegrationAccess" connectionString="Provider=Microsoft.ACE.OLEDB.12.0.0;Data Source=C:\iCCard3000.mdb;Persist Security Info=True;Jet OLEDB:Database Password=<SET_ME>" providerName="System.Data.OleDb" />
